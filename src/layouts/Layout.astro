---
import "../styles/global.css";
import { AGENCY } from "../data/config.js";
const {
  title = "Jarray Rent Car — Location de voitures à Djerba",
  description = "Location de voitures à Djerba, Tunisie. Livraison à l'aéroport et à l'hôtel, voitures récentes, prix transparents. Réservez en ligne en 2 minutes.",
} = Astro.props;
---
<!doctype html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <script is:inline>
    // Apply the saved theme/language before first paint (no flash). Default: dark, French.
    try {
      var d = document.documentElement, th = localStorage.getItem("theme"), lg = localStorage.getItem("lang");
      d.dataset.theme = th === "light" ? "light" : "dark";
      if (lg === "ar" || lg === "en") { d.lang = lg; d.dir = lg === "ar" ? "rtl" : "ltr"; }
    } catch (e) { document.documentElement.dataset.theme = "dark"; }
  </script>
  <link rel="icon" href="/favicon.png" type="image/png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&family=Cairo:wght@400;600;700;800&display=swap" rel="stylesheet">
  {AGENCY.cfAnalyticsToken && (
    <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: AGENCY.cfAnalyticsToken })}></script>
  )}
</head>
<body>
  <slot />
</body>
</html>
