---
import Layout from "../layouts/Layout.astro";
---
<Layout>
  <!-- ===== HEADER + HERO ===== -->
  <header class="top" id="top">
    <div class="bar" id="bar">
      <div class="container bar__inner">
        <a href="#top" class="logo"><span class="logo__mark">J</span>Jarray Rent Car</a>
        <nav class="nav" id="nav">
          <a href="#showroom" data-i18n="nav.showroom">Showroom</a>
          <a href="#fleet" data-i18n="nav.fleet">Voitures</a>
          <a href="#conditions" data-i18n="nav.how">Conditions</a>
          <a href="#faq" data-i18n="nav.faq">FAQ</a>
          <a href="#contact" data-i18n="nav.contact">Contact</a>
        </nav>
        <div class="bar__actions">
          <button class="lang" id="langToggle" aria-label="Change language">EN</button>
          <a class="btn btn--wa btn--sm js-whatsapp" target="_blank" rel="noopener">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.4 8.4 0 0 1-12.6 7.3L3 20l1.3-5.2A8.4 8.4 0 1 1 21 11.5z"/></svg>
            <span>WhatsApp</span>
          </a>
          <button class="burger" id="burger" aria-label="Menu"><span></span><span></span></button>
        </div>
      </div>
    </div>

    <div class="container hero">
      <p class="eyebrow" data-i18n="hero.eyebrow">Djerba · Aéroport &amp; hôtels</p>
      <h1 data-i18n="hero.title">Votre voiture à Djerba, réservée en 2 minutes.</h1>
      <form class="search" id="quickSearch">
        <label class="search__field search__field--wide"><span data-i18n="form.pickupLoc">Prise en charge</span>
          <select name="pickupLoc" class="js-locations" required></select>
        </label>
        <label class="search__field"><span data-i18n="form.pickupDate">Départ</span><input type="date" name="pickupDate" required></label>
        <label class="search__field"><span data-i18n="form.returnDate">Retour</span><input type="date" name="returnDate" required></label>
        <button class="btn btn--accent search__cta" type="submit" data-i18n="search.cta">Voir les voitures</button>
      </form>
      <ul class="perks">
        <li data-i18n="trust.1">Kilométrage illimité</li>
        <li data-i18n="trust.2">Assurance incluse</li>
        <li data-i18n="trust.3">Livraison aéroport offerte</li>
        <li data-i18n="trust.4">Annulation gratuite 48 h</li>
      </ul>
    </div>
  </header>

  <main>
    <!-- ===== 3D SHOWROOM ===== -->
    <section class="showroom" id="showroom" aria-label="Showroom 3D">
      <div class="showroom__stage" id="stage">
        <p class="showroom__hint" data-i18n="show.hint">Glissez pour explorer la flotte</p>
      </div>
      <div class="container showroom__info">
        <button class="round" id="showPrev" aria-label="Previous car"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg></button>
        <div class="showroom__car" aria-live="polite">
          <span class="showroom__cat" id="showCat"></span>
          <h2 id="showName">—</h2>
          <p><b id="showPrice">—</b> <span data-i18n="book.perDayShort">DT / jour</span></p>
        </div>
        <button class="btn btn--accent" id="showPick" data-i18n="show.pick">Réserver celle-ci</button>
        <button class="round" id="showNext" aria-label="Next car"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg></button>
      </div>
    </section>

    <!-- ===== FLEET + BOOKING ===== -->
    <section class="container fleet" id="fleet">
      <div class="fleet__list">
        <div class="fleet__head">
          <div>
            <h2 data-i18n="fleet.title">Nos voitures</h2>
            <p class="muted"><span id="carCount"></span> · <span data-i18n="fleet.sub">prix par jour, tout compris</span></p>
          </div>
          <div class="filters" id="filters">
            <button class="chip is-active" data-filter="all" data-i18n="cat.all">Toutes</button>
            <button class="chip" data-filter="eco" data-i18n="cat.eco">Économique</button>
            <button class="chip" data-filter="compact" data-i18n="cat.compact">Compacte</button>
            <button class="chip" data-filter="suv" data-i18n="cat.suv">SUV</button>
            <button class="chip" data-filter="premium" data-i18n="cat.premium">Premium</button>
          </div>
        </div>
        <div class="grid" id="carGrid"></div>
      </div>

      <aside class="panel" id="booking">
        <div class="panel__head">
          <p class="eyebrow" data-i18n="book.eyebrow">Votre réservation</p>
          <p class="panel__car" id="sumName" data-i18n="book.noCar">Choisissez une voiture</p>
          <p class="panel__meta" id="sumMeta"></p>
        </div>
        <form class="panel__form" id="bookingForm" novalidate>
          <label><span data-i18n="form.car">Voiture</span><select name="car" id="carSelect" required></select></label>
          <label><span data-i18n="form.pickupLoc">Prise en charge</span><select name="pickupLoc" class="js-locations" required></select></label>
          <label><span data-i18n="form.returnLoc">Lieu de retour</span><select name="returnLoc" class="js-locations" required></select></label>
          <div class="two">
            <label><span data-i18n="form.pickupDate">Départ</span><input type="date" name="pickupDate" required></label>
            <label><span data-i18n="form.pickupTime">Heure</span><input type="time" name="pickupTime" value="10:00" required></label>
          </div>
          <div class="two">
            <label><span data-i18n="form.returnDate">Retour</span><input type="date" name="returnDate" required></label>
            <label><span data-i18n="form.returnTime">Heure</span><input type="time" name="returnTime" value="10:00" required></label>
          </div>
          <label><span data-i18n="form.name">Nom complet</span><input type="text" name="name" autocomplete="name" required></label>
          <label><span data-i18n="form.phone">Téléphone / WhatsApp</span><input type="tel" name="phone" autocomplete="tel" required></label>
          <details class="more">
            <summary data-i18n="form.more">Plus d'options (e-mail, vol, siège bébé…)</summary>
            <label><span data-i18n="form.email">E-mail</span><input type="email" name="email" autocomplete="email"></label>
            <label><span data-i18n="form.notes">Message</span><textarea name="notes" rows="3"></textarea></label>
          </details>
          <div class="total">
            <div><span id="sumLine">—</span><b id="sumSub">—</b></div>
            <div><span data-i18n="book.delivery">Livraison aéroport</span><b data-i18n="book.free">Offerte</b></div>
            <div class="total__big"><span data-i18n="book.total">Total estimé</span><b id="sumTotal">—</b></div>
          </div>
          <p class="form__error" id="formError" hidden></p>
          <button class="btn btn--wa btn--block" type="submit" data-i18n="form.submit">Réserver via WhatsApp</button>
          <a class="form__alt" id="mailFallback" href="#" data-i18n="form.mail">Ou envoyer par e-mail</a>
          <p class="muted small center" data-i18n="book.note">Confirmation en quelques minutes · paiement à la remise des clés</p>
        </form>
      </aside>
    </section>

    <!-- ===== HOW ===== -->
    <section class="how">
      <div class="container how__grid">
        <div><p class="how__n">01</p><h3 data-i18n="how.1t">Choisissez</h3><p data-i18n="how.1p">Une voiture, vos dates, le lieu de prise en charge.</p></div>
        <div><p class="how__n">02</p><h3 data-i18n="how.2t">Confirmez</h3><p data-i18n="how.2p">Nous confirmons par WhatsApp ou téléphone.</p></div>
        <div><p class="how__n">03</p><h3 data-i18n="how.3t">Roulez</h3><p data-i18n="how.3p">Clés remises à l'aéroport ou à votre hôtel.</p></div>
      </div>
    </section>

    <!-- ===== RENTAL CONDITIONS (values in src/data/config.js → RENTAL) ===== -->
    <section class="container rules" id="conditions">
      <div class="rules__head">
        <h2 data-i18n="rules.title">Conditions de location</h2>
        <p class="muted" data-i18n="rules.sub">Tout est clair avant de réserver : pas de frais cachés.</p>
      </div>
      <div class="rules__grid" id="rules"></div>
    </section>

    <!-- ===== FAQ + CONTACT ===== -->
    <section class="container faqwrap" id="faq">
      <div class="faqs">
        <h2 data-i18n="faq.title">Questions fréquentes</h2>
        <details class="faq"><summary data-i18n="faq.1q">Quels documents faut-il ?</summary><p data-i18n="faq.1a">Un permis valide depuis au moins 2 ans et une pièce d'identité (CIN ou passeport).</p></details>
        <details class="faq"><summary data-i18n="faq.2q">Y a-t-il une caution ?</summary><p data-i18n="faq.2a">Oui, demandée à la remise des clés et restituée au retour du véhicule.</p></details>
        <details class="faq"><summary data-i18n="faq.3q">Puis-je quitter l'île ?</summary><p data-i18n="faq.3a">Oui, partout en Tunisie. Prévenez-nous à la réservation.</p></details>
        <details class="faq"><summary data-i18n="faq.4q">Comment payer ?</summary><p data-i18n="faq.4a">Espèces (DT, €) ou carte à la prise en charge.</p></details>
      </div>
      <div class="contact" id="contact">
        <h2 data-i18n="contact.title">Contact</h2>
        <ul>
          <li class="js-address"></li>
          <li><a class="js-phone"></a></li>
          <li><a class="js-email"></a></li>
          <li data-i18n="contact.hours">Ouvert 24h/24, 7j/7</li>
        </ul>
        <div class="map"><iframe id="map" loading="lazy" title="Map" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <p>© <span id="year"></span> Jarray Rent Car · Djerba</p>
      <div class="footer__social"><a class="js-fb" href="#">Facebook</a><a class="js-ig" href="#">Instagram</a></div>
    </div>
  </footer>

  <a class="wa-float js-whatsapp" target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor" aria-hidden="true"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>
  </a>
</Layout>

<script>
  import "../scripts/main.js";
</script>
