---
import Layout from "../layouts/Layout.astro";
---
<Layout>

  <!-- ===== HEADER ===== -->
  <header class="header" id="header">
    <div class="container header__inner">
      <a href="#top" class="logo"><span class="logo__mark">J</span><span>Jarray<b>RentCar</b></span></a>
      <nav class="nav" id="nav">
        <a href="#fleet" data-i18n="nav.fleet">Nos voitures</a>
        <a href="#why" data-i18n="nav.why">Pourquoi nous</a>
        <a href="#how" data-i18n="nav.how">Comment ça marche</a>
        <a href="#faq" data-i18n="nav.faq">FAQ</a>
        <a href="#contact" data-i18n="nav.contact">Contact</a>
      </nav>
      <div class="header__actions">
        <button class="lang" id="langToggle" aria-label="Change language">EN</button>
        <a href="#booking" class="btn btn--primary btn--sm" data-i18n="nav.book">Réserver</a>
        <button class="burger" id="burger" aria-label="Menu"><span></span><span></span></button>
      </div>
    </div>
  </header>

  <main id="top">
    <!-- ===== HERO ===== -->
    <section class="hero">
      <div class="hero__bg"></div>
      <div class="container hero__inner">
        <div class="hero__text reveal">
          <span class="pill" data-i18n="hero.pill">📍 Djerba · Tunisie</span>
          <h1 data-i18n-html="hero.title">Explorez Djerba<br><span class="accent">en toute liberté.</span></h1>
          <p class="lead" data-i18n="hero.lead">Voitures récentes, livrées à l'aéroport ou à votre hôtel. Prix clairs, sans surprise. Réservation en 2 minutes.</p>
          <div class="hero__stats">
            <div><strong>500+</strong><span data-i18n="hero.s1">clients satisfaits</span></div>
            <div><strong>24/7</strong><span data-i18n="hero.s2">assistance</span></div>
            <div><strong>4.9★</strong><span data-i18n="hero.s3">note moyenne</span></div>
          </div>
        </div>

        <!-- Quick search -->
        <form class="search reveal" id="quickSearch">
          <h3 data-i18n="search.title">Trouvez votre voiture</h3>
          <label><span data-i18n="form.pickupLoc">Lieu de prise en charge</span>
            <select name="pickupLoc" class="js-locations" required></select>
          </label>
          <div class="row">
            <label><span data-i18n="form.pickupDate">Départ</span><input type="date" name="pickupDate" required></label>
            <label><span data-i18n="form.returnDate">Retour</span><input type="date" name="returnDate" required></label>
          </div>
          <button class="btn btn--primary btn--block" type="submit" data-i18n="search.cta">Voir les voitures disponibles</button>
        </form>
      </div>
    </section>

    <!-- ===== TRUST BAR ===== -->
    <div class="trust">
      <div class="container trust__inner">
        <span data-i18n="trust.1">✓ Kilométrage illimité</span>
        <span data-i18n="trust.2">✓ Assurance incluse</span>
        <span data-i18n="trust.3">✓ Livraison aéroport gratuite</span>
        <span data-i18n="trust.4">✓ Annulation gratuite 48h</span>
      </div>
    </div>

    <!-- ===== FLEET ===== -->
    <section class="section" id="fleet">
      <div class="container">
        <div class="section__head reveal">
          <span class="eyebrow" data-i18n="fleet.eyebrow">Notre flotte</span>
          <h2 data-i18n="fleet.title">Choisissez la voiture idéale</h2>
          <p data-i18n="fleet.sub">Des citadines économiques aux SUV confortables, toutes entretenues avec soin.</p>
        </div>
        <div class="filters" id="filters">
          <button class="chip is-active" data-filter="all" data-i18n="cat.all">Toutes</button>
          <button class="chip" data-filter="eco" data-i18n="cat.eco">Économique</button>
          <button class="chip" data-filter="compact" data-i18n="cat.compact">Compacte</button>
          <button class="chip" data-filter="suv" data-i18n="cat.suv">SUV</button>
          <button class="chip" data-filter="premium" data-i18n="cat.premium">Premium</button>
        </div>
        <div class="grid" id="carGrid"></div>
      </div>
    </section>

    <!-- ===== WHY US ===== -->
    <section class="section section--alt" id="why">
      <div class="container">
        <div class="section__head reveal">
          <span class="eyebrow" data-i18n="why.eyebrow">Pourquoi nous choisir</span>
          <h2 data-i18n="why.title">Une location simple, sereine et locale</h2>
        </div>
        <div class="features">
          <div class="feature reveal"><div class="feature__icon">✈️</div><h4 data-i18n="why.1t">Livraison aéroport & hôtel</h4><p data-i18n="why.1p">Nous vous attendons à l'arrivée à Djerba-Zarzis ou directement à votre hôtel.</p></div>
          <div class="feature reveal"><div class="feature__icon">🛡️</div><h4 data-i18n="why.2t">Assurance incluse</h4><p data-i18n="why.2p">Tous nos véhicules sont assurés. Roulez l'esprit tranquille.</p></div>
          <div class="feature reveal"><div class="feature__icon">💰</div><h4 data-i18n="why.3t">Prix transparents</h4><p data-i18n="why.3p">Le prix affiché est le prix payé. Aucun frais caché.</p></div>
          <div class="feature reveal"><div class="feature__icon">📞</div><h4 data-i18n="why.4t">Assistance 24/7</h4><p data-i18n="why.4p">Une équipe locale joignable à tout moment par téléphone ou WhatsApp.</p></div>
        </div>
      </div>
    </section>

    <!-- ===== HOW ===== -->
    <section class="section" id="how">
      <div class="container">
        <div class="section__head reveal">
          <span class="eyebrow" data-i18n="how.eyebrow">Comment ça marche</span>
          <h2 data-i18n="how.title">Réservez en 3 étapes</h2>
        </div>
        <div class="steps">
          <div class="step reveal"><span>1</span><h4 data-i18n="how.1t">Choisissez</h4><p data-i18n="how.1p">Sélectionnez votre voiture, vos dates et le lieu de prise en charge.</p></div>
          <div class="step reveal"><span>2</span><h4 data-i18n="how.2t">Confirmez</h4><p data-i18n="how.2p">Envoyez votre demande, nous confirmons rapidement par WhatsApp ou téléphone.</p></div>
          <div class="step reveal"><span>3</span><h4 data-i18n="how.3t">Roulez</h4><p data-i18n="how.3p">Récupérez les clés et profitez de l'île des rêves.</p></div>
        </div>
      </div>
    </section>

    <!-- ===== BOOKING ===== -->
    <section class="section section--dark" id="booking">
      <div class="container booking">
        <div class="booking__intro reveal">
          <span class="eyebrow" data-i18n="book.eyebrow">Réservation</span>
          <h2 data-i18n="book.title">Réservez votre voiture</h2>
          <p data-i18n="book.sub">Remplissez le formulaire : votre demande nous parvient instantanément et nous vous confirmons la disponibilité en quelques minutes.</p>
          <div class="summary" id="summary">
            <div class="summary__car" id="summaryCar"><span data-i18n="book.noCar">Aucune voiture sélectionnée</span></div>
            <div class="summary__row"><span data-i18n="book.days">Durée</span><b id="sumDays">—</b></div>
            <div class="summary__row"><span data-i18n="book.perDay">Prix / jour</span><b id="sumPrice">—</b></div>
            <div class="summary__row summary__total"><span data-i18n="book.total">Total estimé</span><b id="sumTotal">—</b></div>
          </div>
        </div>

        <form class="form reveal" id="bookingForm" novalidate>
          <label class="full"><span data-i18n="form.car">Voiture</span>
            <select name="car" id="carSelect" required></select>
          </label>
          <label><span data-i18n="form.pickupLoc">Lieu de prise en charge</span><select name="pickupLoc" class="js-locations" required></select></label>
          <label><span data-i18n="form.returnLoc">Lieu de retour</span><select name="returnLoc" class="js-locations" required></select></label>
          <label><span data-i18n="form.pickupDate">Départ</span><input type="date" name="pickupDate" required></label>
          <label><span data-i18n="form.pickupTime">Heure</span><input type="time" name="pickupTime" value="10:00" required></label>
          <label><span data-i18n="form.returnDate">Retour</span><input type="date" name="returnDate" required></label>
          <label><span data-i18n="form.returnTime">Heure</span><input type="time" name="returnTime" value="10:00" required></label>
          <label><span data-i18n="form.name">Nom complet</span><input type="text" name="name" autocomplete="name" required></label>
          <label><span data-i18n="form.phone">Téléphone / WhatsApp</span><input type="tel" name="phone" autocomplete="tel" required></label>
          <label class="full"><span data-i18n="form.email">E-mail (optionnel)</span><input type="email" name="email" autocomplete="email"></label>
          <label class="full"><span data-i18n="form.notes">Message (vol, siège bébé, etc.)</span><textarea name="notes" rows="3"></textarea></label>
          <p class="form__error full" id="formError" hidden></p>
          <button class="btn btn--primary btn--block full" type="submit"><span data-i18n="form.submit">Envoyer la réservation via WhatsApp</span></button>
          <a class="form__alt full" id="mailFallback" href="#" data-i18n="form.mail">Ou envoyer par e-mail</a>
        </form>
      </div>
    </section>

    <!-- ===== TESTIMONIALS ===== -->
    <section class="section">
      <div class="container">
        <div class="section__head reveal">
          <span class="eyebrow" data-i18n="rev.eyebrow">Avis clients</span>
          <h2 data-i18n="rev.title">Ils nous ont fait confiance</h2>
        </div>
        <div class="reviews">
          <blockquote class="review reveal"><div class="stars">★★★★★</div><p>“Voiture impeccable livrée à l'aéroport à minuit. Service au top, je recommande !”</p><cite>Sophie · France</cite></blockquote>
          <blockquote class="review reveal"><div class="stars">★★★★★</div><p>“Very friendly team, fair price and a clean car. Perfect to discover Djerba.”</p><cite>Mark · Germany</cite></blockquote>
          <blockquote class="review reveal"><div class="stars">★★★★★</div><p>“Réservation rapide par WhatsApp, aucun frais caché. Merci l'équipe !”</p><cite>Karim · Tunis</cite></blockquote>
        </div>
      </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="section section--alt" id="faq">
      <div class="container container--narrow">
        <div class="section__head reveal">
          <span class="eyebrow">FAQ</span>
          <h2 data-i18n="faq.title">Questions fréquentes</h2>
        </div>
        <details class="faq reveal"><summary data-i18n="faq.1q">Quels documents faut-il pour louer ?</summary><p data-i18n="faq.1a">Un permis de conduire valide depuis au moins 2 ans et une pièce d'identité (CIN ou passeport).</p></details>
        <details class="faq reveal"><summary data-i18n="faq.2q">Y a-t-il une caution ?</summary><p data-i18n="faq.2a">Oui, une caution est demandée à la remise des clés et restituée au retour du véhicule.</p></details>
        <details class="faq reveal"><summary data-i18n="faq.3q">Puis-je quitter l'île avec la voiture ?</summary><p data-i18n="faq.3a">Oui, vous pouvez circuler partout en Tunisie. Prévenez-nous simplement lors de la réservation.</p></details>
        <details class="faq reveal"><summary data-i18n="faq.4q">Comment payer ?</summary><p data-i18n="faq.4a">Paiement en espèces (dinars, euros) ou par carte à la prise en charge du véhicule.</p></details>
      </div>
    </section>

    <!-- ===== CONTACT ===== -->
    <section class="section" id="contact">
      <div class="container contact">
        <div class="contact__info reveal">
          <span class="eyebrow" data-i18n="contact.eyebrow">Contact</span>
          <h2 data-i18n="contact.title">Nous trouver</h2>
          <ul class="contact__list">
            <li>📍 <span class="js-address"></span></li>
            <li>📞 <a class="js-phone"></a></li>
            <li>💬 <a class="js-whatsapp" target="_blank" rel="noopener">WhatsApp</a></li>
            <li>✉️ <a class="js-email"></a></li>
            <li>🕐 <span data-i18n="contact.hours">Ouvert 7j/7 · 08:00 – 22:00</span></li>
          </ul>
        </div>
        <div class="map reveal"><iframe id="map" loading="lazy" title="Map" referrerpolicy="no-referrer-when-downgrade"></iframe></div>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container footer__inner">
      <a href="#top" class="logo"><span class="logo__mark">J</span><span>Jarray<b>RentCar</b></span></a>
      <p>© <span id="year"></span> Jarray Rent Car · Djerba, Tunisie</p>
      <div class="footer__social"><a class="js-fb" href="#">Facebook</a><a class="js-ig" href="#">Instagram</a></div>
    </div>
  </footer>

  <a class="wa-float js-whatsapp" target="_blank" rel="noopener" aria-label="WhatsApp">
    <svg viewBox="0 0 24 24" width="28" height="28" fill="currentColor"><path d="M17.5 14.4c-.3-.1-1.8-.9-2-1-.3-.1-.5-.1-.7.1-.2.3-.8 1-.9 1.2-.2.2-.3.2-.6.1-.3-.1-1.3-.5-2.4-1.5-.9-.8-1.5-1.8-1.7-2.1-.2-.3 0-.5.1-.6l.4-.5c.2-.2.2-.3.3-.5.1-.2 0-.4 0-.5l-.9-2.2c-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.1.2 2.1 3.2 5.1 4.5.7.3 1.3.5 1.7.6.7.2 1.4.2 1.9.1.6-.1 1.8-.7 2-1.4.2-.7.2-1.3.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2z"/></svg>
  </a>

</Layout>

<script>
  import "../scripts/main.js";
</script>
