{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jarrayrentcar",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  // Serve on jarrayrentcar.<subdomain>.workers.dev (until a custom domain is added)
  "workers_dev": true,
  // Wrangler runs this before every deploy, so dist/ always exists
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Only these paths hit the Worker; everything else is served straight from the static assets
    "run_worker_first": ["/api/*", "/admin", "/admin.csv", "/admin/*"]
  },
  "d1_databases": [
    {
      "binding": "jarray_bookings",
      "database_name": "jarray-bookings",
      "database_id": "4bbeee2e-bb49-45b6-9ca4-ac7d264c9779",
      "migrations_dir": "migrations"
    }
  ]
}
